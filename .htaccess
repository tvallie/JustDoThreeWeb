Options -Indexes

# Force HTTPS and non-www canonical URL
RewriteEngine On

# If not already HTTPS, redirect to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://justdothree.com%{REQUEST_URI} [R=301,L]

# If www, redirect to non-www (already HTTPS at this point)
RewriteCond %{HTTP_HOST} ^www\.justdothree\.com$ [NC]
RewriteRule ^ https://justdothree.com%{REQUEST_URI} [R=301,L]

# Sitemap
Sitemap: https://justdothree.com/sitemap.xml
